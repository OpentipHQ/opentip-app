// Opentip app schema. Apply with Prisma Migrate only. Do not use db push.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum SiteStatus {
  PENDING
  ACTIVE
  PAUSED
}

enum SiteTheme {
  LEDGER
  MINIMAL
}

enum Appearance {
  SYSTEM
  LIGHT
  DARK
}

enum JobKind {
  FIRST_BUILD
  PUSH_UPDATE
  CHAT_EDIT
  SUMMARY_REFRESH
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobPhase {
  QUEUED
  READING_REPO
  GENERATING
  VALIDATING
  PUBLISHING
  COMPLETE
}

enum ReviewMode {
  AUTO_PUBLISH
  REVIEW
}

enum RevisionStatus {
  PENDING
  PUBLISHED
  REJECTED
  SUPERSEDED
}

enum RevisionSource {
  FIRST_BUILD
  PUSH_UPDATE
  CHAT_EDIT
}

enum RevisionAction {
  UPSERT
  DELETE
}

enum JobProvider {
  XAI
  GROQ
  FAKE
}

enum UsageStatus {
  RESERVED
  FINAL
}

enum AlertKind {
  DAILY_TOTAL
  USER_OUTLIER
}

model User {
  id                String   @id @default(cuid())
  githubId          String?  @unique
  login             String
  name              String?
  email             String?  @unique
  avatarUrl         String?
  imageUrl          String?
  role              UserRole @default(USER)
  emailSignInEnabled Boolean @default(true)
  sessionVersion    Int      @default(0)
  suspendedAt       DateTime?
  creditUsd         Decimal  @default(0) @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  installations      Installation[]
  sites              Site[]
  chatEdits          ChatEdit[]
  feedback           Feedback[]
  betaInvites        BetaInvite[]
  subscription       Subscription?
  activityLogs       ActivityLog[]  @relation("ActivityActor")
  announcements      Announcement[] @relation("AnnouncementAuthor")
  loginCodes         LoginCode[]
}

model Installation {
  id                   String    @id @default(cuid())
  githubInstallationId String    @unique
  accountLogin         String
  accountType          String
  accountAvatarUrl     String?
  uninstalledAt        DateTime?
  suspendedAt          DateTime?
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  repos                Repo[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Repo {
  id              String    @id @default(cuid())
  installationId  String
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  githubRepoId    String    @unique
  owner           String
  name            String
  fullName        String
  private         Boolean   @default(false)
  defaultBranch   String    @default("main")
  archived        Boolean   @default(false)
  removed         Boolean   @default(false)
  summary         String?   @db.Text
  summarySha      String?
  summaryCachedAt DateTime?
  pushedAt        DateTime?
  site            Site?
  jobs            Job[]
  usage           UsageEntry[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([installationId])
  @@index([fullName])
}

model Site {
  id                 String     @id @default(cuid())
  repoId             String     @unique
  repo               Repo       @relation(fields: [repoId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  subdomain          String     @unique
  customDomain       String?    @unique
  customDomainStatus String?
  status             SiteStatus @default(PENDING)
  pausedReason       String?
  reviewMode         ReviewMode @default(AUTO_PUBLISH)
  theme              SiteTheme  @default(MINIMAL)
  appearance         Appearance @default(SYSTEM)
  primaryColor       String     @default("#2A2AD6")
  logoLightUrl       String?
  logoDarkUrl        String?
  faviconUrl         String?
  logoHref           String?
  ogBackgroundUrl    String?
  ogImageUrl         String?
  description        String?
  pages              Page[]
  revisions          PageRevision[]
  worklog            WorklogEntry[]
  chatEdits          ChatEdit[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([ownerId])
  @@index([status])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug        String
  section     String?
  title       String
  description String?
  content     String   @db.Text
  navOrder    Int      @default(0)
  handEdited  Boolean  @default(false)
  published   Boolean  @default(false)
  noindex     Boolean  @default(false)
  ogImageUrl  String?
  chatEdits   ChatEdit[]
  revisions   PageRevision[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, published])
}

model Job {
  id               String      @id @default(cuid())
  repoId           String
  repo             Repo        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  kind             JobKind
  status           JobStatus   @default(QUEUED)
  phase            JobPhase    @default(QUEUED)
  progress         Int         @default(0)
  detail           String?
  provider         JobProvider
  model            String
  idempotencyKey   String      @unique
  deliveryId       String?
  payload          Json?
  error            String?     @db.Text
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  estimatedCostUsd Decimal     @default(0) @db.Decimal(12, 6)
  attempts         Int         @default(0)
  maxAttempts      Int         @default(3)
  availableAt      DateTime    @default(now())
  leaseUntil       DateTime?
  lockedBy         String?
  lastHeartbeatAt  DateTime?
  chatEdit         ChatEdit?
  usage            UsageEntry[]
  revisions        PageRevision[]
  events           JobEvent[]
  createdAt        DateTime    @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  @@index([repoId, createdAt])
  @@index([status, availableAt])
  @@index([leaseUntil])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sequence  Int
  level     String   @default("info")
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
}

model PageRevision {
  id          String         @id @default(cuid())
  siteId      String
  site        Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageId      String?
  page        Page?          @relation(fields: [pageId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  action      RevisionAction @default(UPSERT)
  status      RevisionStatus @default(PENDING)
  source      RevisionSource
  slug        String
  section     String?
  title       String
  description String?
  content     String         @db.Text
  navOrder    Int            @default(0)
  baseSha     String?
  changeNote  String?
  reviewNote  String?
  publishedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([siteId, status, createdAt])
  @@index([pageId])
  @@index([jobId])
}

model WebhookDelivery {
  id         String   @id
  event      String
  action     String?
  jobId      String?
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model WebhookError {
  id         String   @id @default(cuid())
  deliveryId String
  event      String
  action     String?
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ChatEdit {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageId      String?
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruction String   @db.Text
  jobId       String?  @unique
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model WorklogEntry {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title       String
  body        String   @db.Text
  source      String   @default("manual")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([siteId, publishedAt])
}

model Plan {
  id              String   @id
  tier            PlanTier @unique
  name            String
  priceCents      Int
  customDomain    Boolean  @default(false)
  dailyRepoCapUsd Decimal  @db.Decimal(12, 4)
  subscriptions   Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  status    String   @default("beta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageEntry {
  id               String      @id @default(cuid())
  repoId           String
  repo             Repo        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  jobId            String?
  job              Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  day              DateTime    @db.Date
  provider         JobProvider
  model            String
  status           UsageStatus @default(RESERVED)
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  estimatedCostUsd Decimal     @db.Decimal(12, 6)
  createdAt        DateTime    @default(now())

  @@index([repoId, day])
  @@index([day])
  @@index([jobId])
}

model BetaInvite {
  id         String    @id @default(cuid())
  email      String
  wave       Int       @default(1)
  token      String    @unique
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sentAt     DateTime?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([wave])
}

// Legacy local applications table. Admin reads the marketing beta_application table.
model BetaApplication {
  id          String   @id @default(cuid())
  email       String
  githubLogin String?
  xHandle     String?
  priceAnswer String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  access      BetaAccess?

  @@index([status])
}

// One row per email that may sign in during the closed beta.
// Approving a marketing beta application upserts this row. Invites do the same.
model BetaAccess {
  id            String           @id @default(cuid())
  email         String           @unique
  applicationId String?          @unique
  application   BetaApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  approvedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
}

// Product email preferences, keyed by the normalized address.
// Transactional email ignores this table. Announcement email does not.
model EmailPreference {
  email         String   @id
  announcements Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Hashed 6-digit sign-in codes. The plaintext code is never stored.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("signin")
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ipHash     String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([userId, purpose, createdAt])
}

// Installations that arrived from GitHub before an approved session existed.
// The cookie holds the selector. Only the hash is stored. No GitHub user token.
model PendingInstall {
  id               String    @id @default(cuid())
  selectorHash     String    @unique
  githubUserId     String
  email            String?
  login            String
  name             String?
  avatarUrl        String?
  installationJson Json
  reposJson        Json
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  siteId    String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model Announcement {
  id                String   @id @default(cuid())
  title             String
  body              String   @db.Text
  active            Boolean  @default(true)
  emailRequested    Boolean  @default(false)
  emailSentAt       DateTime?
  emailRecipientCount Int    @default(0)
  authorId          String?
  author            User?    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active, createdAt])
}

model SpendAlert {
  id        String    @id @default(cuid())
  scopeKey  String    @unique
  kind      AlertKind
  day       DateTime  @db.Date
  userId    String?
  amountUsd Decimal   @db.Decimal(12, 6)
  createdAt DateTime  @default(now())

  @@index([day])
}

# GitHub App numeric id from the app settings page.
GITHUB_APP_ID=

# Public slug of the GitHub App named Opentip Copilot.
# The name Opentip is reserved on GitHub, so the registered slug is opentip-copilot.
# Install URL: https://github.com/apps/opentip-copilot/installations/new
GITHUB_APP_SLUG=opentip-copilot

# GitHub App private key, PEM. Keep it on one line with \n for newlines.
# Never commit the real key. *.pem is gitignored.
GITHUB_APP_PRIVATE_KEY=

# Webhook secret you set when registering the GitHub App.
GITHUB_WEBHOOK_SECRET=

# OAuth client id of the same GitHub App. Used for sign-in.
GITHUB_CLIENT_ID=

# OAuth client secret of the same GitHub App.
GITHUB_CLIENT_SECRET=

# Neon Postgres connection string for this app.
# Use a database that is separate from the marketing site BETA_DATABASE_URL.
# Prefer the direct (unpooled) URL for `prisma migrate deploy`.
DATABASE_URL=

# xAI API key. Heavy Copilot jobs use grok-build-0.1.
# In development, a fake provider is used when this is empty.
# In production, heavy jobs fail closed when this is empty.
XAI_API_KEY=

# Groq API key. Small push updates and small edits use gpt-oss-120b.
# In development, a fake provider is used when this is empty.
# In production, small jobs fail closed when this is empty.
GROQ_API_KEY=

# Resend API key. Used for beta invite email and the 6-digit sign-in code.
# In development, codes are not sent when this is empty. Set LOGIN_CODE_SINK to keep them locally.
# Production refuses to send when this is empty.
RESEND_API_KEY=

# Verified Resend sender, for example Opentip <beta@opentip.tech>.
# Required together with RESEND_API_KEY before an email is sent.
RESEND_FROM=

# Local file for sign-in codes when Resend is not configured.
# Example: .local/login-codes.log
# Ignored when NODE_ENV is production. Never commit the file. Never put a real code here.
LOGIN_CODE_SINK=

# HMAC secret for signed dynamic OG images. Required in production.
# Development uses a local stand-in when this is empty.
OG_SIGNING_SECRET=

# Signs the session cookie. Required in production.
# Development uses a local stand-in when this is empty.
SESSION_SECRET=

# Comma-separated emails that are approved for the beta and signed in as admins.
# Use this to create the first admin in production. They become an admin the next time they sign in.
# An email removed from this list keeps an existing admin role. Further sign-ins then require a BetaAccess row.
# Example: you@opentip.tech,other@opentip.tech
ADMIN_EMAILS=

# Public URL of this app. Callback and setup URLs are derived from it.
APP_URL=https://beta.opentip.tech

# Root domain for docs subdomains: {subdomain}.opentip.tech
DOCS_ROOT_DOMAIN=opentip.tech

# Optional model overrides.
# Heavy default is grok-build-0.1. grok-4.7 is a config option only.
XAI_HEAVY_MODEL=grok-build-0.1
# Small default on Groq.
GROQ_SMALL_MODEL=openai/gpt-oss-120b

# Internal USD estimates used only for daily caps. They are not an invoice.
# grok-build-0.1 list prices: $1 input and $2 output per million tokens.
XAI_INPUT_USD_PER_MTOK=1
XAI_OUTPUT_USD_PER_MTOK=2
GROQ_INPUT_USD_PER_MTOK=0.15
GROQ_OUTPUT_USD_PER_MTOK=0.75

# Per-repo and global daily spend caps, in USD.
REPO_DAILY_CAP_USD=2
GLOBAL_DAILY_CAP_USD=25

# How long a cached repo summary is reused, in hours.
SUMMARY_TTL_HOURS=24

# Set to 1 to show plan prices on the billing page. Hidden during beta.
SHOW_PLAN_PRICES=0

# Set to 1 in local development to open the dashboard without GitHub keys.
# Ignored when NODE_ENV is production.
AUTH_DEV_BYPASS=0

# Set to fake to force the fake Copilot provider even when API keys exist.
# Leave empty in production.
COPILOT_PROVIDER=
